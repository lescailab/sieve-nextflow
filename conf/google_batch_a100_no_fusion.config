/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    lescailab/sieve Nextflow config — Google Batch, A100 GPU, no Fusion filesystem
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Run GPU-enabled processes on Google Batch using NVIDIA A100 accelerators.
    Cloud Storage staging uses standard GCS operations; Fusion is NOT enabled.
    Requires the `gpu` profile to be combined at runtime, e.g.:
        nextflow run . -profile google_batch_a100_no_fusion,docker,gpu
----------------------------------------------------------------------------------------
*/

process {
    executor = 'google-batch'

    withLabel: process_gpu {
        machineType    = 'a2-highgpu-1g'
        accelerator    = [request: 1, type: 'nvidia-tesla-a100']
        // A100 VMs have 85 GB GPU memory; raise CPU and host RAM to match.
        cpus           = { 12 * task.attempt }
        memory         = { 85.GB * task.attempt }
        time           = { 72.h  * task.attempt }
    }
}

google {
    location         = 'us-central1'
    batch {
        spot = true
    }
    // Fusion is deliberately disabled for this profile.
    // Files are staged through standard Cloud Storage transfer.
}
