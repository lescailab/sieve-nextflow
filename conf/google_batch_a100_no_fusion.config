/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A100 GPU Config with NO Fusion + Large Boot Disk
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU-optimized Google Batch config with local staging (no Fusion) and large boot disk.

    Configuration:
    - A100 GPUs (40GB) with a2-highgpu-1g machine type
    - 500GB boot disk for all tasks (critical for local staging)
    - Fusion disabled globally
    - Local staging enforced for all processes
    - No spot instances for reliability

    Usage:
      nextflow run . -profile google_batch_a100_no_fusion \
        --execute_step train \
        --vcf ... --phenotypes ...

    IMPORTANT: Set the following in your environment or nextflow.config:
      - google.project: Your GCP project ID
      - google.location/region: Your preferred GCP region
      - workDir: Your GCS bucket for work directory
      - cloudcache.path: Your GCS bucket for cache
----------------------------------------------------------------------------------------
*/

// Disable Fusion globally
fusion.enabled = false
wave.enabled = false

// Set environment for no Fusion
env {
    FUSION_ENABLED = 'false'
    TMPDIR = '/tmp'
    TEMP = '/tmp'
    TMP = '/tmp'
}

// Google Batch settings with large boot disk
google {
    // Set these via environment or params:
    // location = 'YOUR-REGION'  // e.g., 'us-central1', 'europe-west3'
    // region = 'YOUR-REGION'
    // project = 'YOUR-PROJECT-ID'

    batch {
        // Head job (orchestrator)
        head {
            machineType = 'n2-standard-4'
            spot = false
            bootDiskSizeGb = 200
        }

        // Task jobs - NO SPOT, LARGE BOOT DISK
        spot = false
        maxSpotAttempts = 0
        autoRetryExitCodes = [50001, 50002]
        bootDiskSize = '500 GB'  // Large boot disk for local staging
    }
}

// CloudCache - set path via workDir or params
// cloudcache {
//     enabled = true
//     path = 'gs://YOUR-BUCKET/cache'
// }

// Process-specific resource allocations
process {
    executor = 'google-batch'

    // Force local staging for all processes
    scratch = true
    stageInMode = 'copy'
    stageOutMode = 'copy'

    // Default resources for non-GPU processes
    cpus = 4
    memory = 16.GB
    disk = '100 GB'

    // GPU process configuration - A100 40GB
    withLabel: process_gpu {
        ext.use_gpu = true
        machineType = 'a2-highgpu-1g'  // 1x A100 40GB, 12 vCPUs, 85GB RAM
        disk = '500 GB'  // Large disk for local staging
        accelerator {
            request = 1
            type = 'nvidia-tesla-a100'
        }
        maxRetries = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }

        // Ensure local staging
        scratch = true
        stageInMode = 'copy'
        stageOutMode = 'copy'
    }

    // High memory processes
    withLabel: process_high_memory {
        cpus = 16
        memory = 64.GB
        disk = '200 GB'
    }

    // Low resource processes
    withLabel: process_low {
        cpus = 2
        memory = 8.GB
        disk = '50 GB'
    }

    // Optional: Add resource labels for cost tracking
    // resourceLabels = [
    //     scope: 'your-scope',
    //     type: 'nextflow',
    //     env: 'gpu'
    // ]
}

// Retry settings with exponential backoff
// Set max_retries = 1 in params to avoid excessive retries
params {
    max_retries = 1
}
