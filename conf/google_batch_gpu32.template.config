/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    lescailab/sieve Google Cloud Batch template config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Template only: this file is NOT loaded by default.
    Use it explicitly with:
      nextflow run . -c conf/google_batch_gpu32.template.config
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Google Cloud Batch (GPU >= 32 GB + cloud cache) template'
    config_profile_description = 'Template config for Google Cloud Batch with split head/task sizing, cloud cache, and A100-class process_gpu tasks.'

    // Pipeline output base path (placeholder). Override with `--outdir` or `-output-dir`.
    outdir = 'gs://<YOUR_OUTPUT_BUCKET>/<PIPELINE_RESULTS_PREFIX>'
}

/*
 * Edit these paths before running.
 * Google Batch requires a GCS work directory that includes at least one subdirectory.
 */
workDir = 'gs://<YOUR_WORK_BUCKET>/<PIPELINE_WORK_PREFIX>'

/*
 * Nextflow workflow output directory (same concept as `-output-dir`).
 * Kept aligned with `params.outdir` so publish paths are cloud-native by default.
 */
outputDir = params.outdir

process {
    executor = 'google-batch'

    /*
     * Keep GPU requirements only on processes already labeled `process_gpu`.
     * `a2-highgpu-1g` provides one NVIDIA A100 40 GB GPU (>= 32 GB requirement).
     */
    withLabel:process_gpu {
        ext.use_gpu = true
        accelerator = 1
        machineType = 'a2-highgpu-1g'
    }
}

google {
    project  = '<YOUR_GCP_PROJECT_ID>'
    location = '<YOUR_GCP_REGION>' // Example: us-central1

    batch {
        /*
         * Head job resources (launcher / orchestration VM).
         * Keep this lightweight and on-demand.
         */
        head {
            machineType = 'n2-standard-4'
            spot = false
            bootDiskSizeGb = 200
        }

        // Defaults for Batch task jobs
        spot = true
        maxSpotAttempts = 5
        autoRetryExitCodes = [50001]
        machineType = 'n2-*,c3-*,n1-*'
        bootDiskSize = '100 GB'
    }
}

cloudcache {
    enabled = true
    path = 'gs://<YOUR_CACHE_BUCKET>/<CLOUDCACHE_PREFIX>'
}

// Recommended for cloud-native file I/O with Google Cloud Storage.
fusion.enabled = true
