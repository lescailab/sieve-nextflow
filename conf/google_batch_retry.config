/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Google Batch Error Handling Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This config adds retry logic for Google Batch infrastructure errors (50001-50005)
    Include this config when running on Google Batch to handle VM failures gracefully.

    Usage: nextflow run main.nf -c conf/google_batch_retry.config -resume
----------------------------------------------------------------------------------------
*/

process {
    // Enhanced error strategy for Google Batch infrastructure errors
    // Exit codes:
    //   50001: Batch service error
    //   50002: VM communication lost (most common - VM preemption or crash)
    //   50003: VM resource exhaustion
    //   50004: VM boot failure
    //   50005: Walltime timeout
    //   130-145: SIGTERM/SIGKILL signals
    //   104: Connection reset
    //   175: Container/execution errors

    errorStrategy = {
        task.exitStatus in ((130..145) + [104, 175, 50001, 50002, 50003, 50004, 50005]) ? 'retry' : 'finish'
    }

    // Increase retries for better resilience
    maxRetries = 3
    maxErrors  = '-1'

    // Scale resources on retry to avoid repeated failures
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Specific handling for GPU/high-resource processes
    withLabel: process_gpu {
        // GPU tasks are more susceptible to VM failures
        maxRetries = 5
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }

        // Add exponential backoff delay between retries
        errorStrategy = {
            if (task.exitStatus in [50001, 50002, 50003, 50004]) {
                sleep(Math.pow(2, task.attempt - 1) * 60000) // 1min, 2min, 4min, 8min delays
                return 'retry'
            }
            task.exitStatus in ((130..145) + [104, 175, 50005]) ? 'retry' : 'finish'
        }
    }

    // High-memory processes often trigger 50002 errors
    withLabel: process_high_memory {
        maxRetries = 4
        memory = { 200.GB * task.attempt }
    }
}

// Google Batch specific settings for better reliability
google {
    batch {
        // Consider disabling spot instances for critical production runs
        // spot = false

        // Increase VM boot disk size to avoid disk full issues
        bootDiskSize = 50.GB

        // Set network for better connectivity
        // network = 'projects/YOUR_PROJECT/global/networks/default'
        // subnetwork = 'projects/YOUR_PROJECT/regions/YOUR_REGION/subnetworks/default'
    }
}
