/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GPU Local Disk Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Forces GPU processes to use local disk instead of Fusion virtual filesystem.

    Changes:
    - GPU processes use 500GB boot disk
    - GPU processes stage files to local disk (not Fusion)
    - All other processes remain unchanged

    Usage: Include this config AFTER your main Google Batch config:
      nextflow run . -c conf/google_batch_gpu32_no_spot.config -c conf/gpu_local_disk.config
----------------------------------------------------------------------------------------
*/

// Disable Fusion globally - affects all processes
fusion.enabled = false

// GPU processes get large boot disk and local staging
process {
    withLabel: process_gpu {
        disk = '500.GB'
        scratch = true
        stageInMode = 'copy'
        stageOutMode = 'copy'
    }
}

// Ensure Google Batch uses 500GB boot disks
google {
    batch {
        bootDiskSize = '500 GB'
    }
}

// Disable cloud cache when using local staging
cloudcache.enabled = false

// Set temp directory to local scratch
env {
    FUSION_ENABLED = 'false'
    TMPDIR = '/tmp'
    TEMP = '/tmp'
    TMP = '/tmp'
}
