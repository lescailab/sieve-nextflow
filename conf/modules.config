/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for module-specific process options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Helpers
    Building command-line flag fragments only when the corresponding pipeline
    parameter is set. Implemented as Groovy closures so they are evaluated
    lazily per process instance and so the same composition logic can be reused
    by every withName selector below.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

def trainExtraArgs = {
    def parts = []
    if (params.pc_map) {
        parts << "--pc-map ${file(params.pc_map).toAbsolutePath()}"
    }
    return parts.join(' ')
}

def explainExtraArgs = {
    def parts = []
    if (params.explain_n_steps != null)            { parts << "--n-steps ${params.explain_n_steps}" }
    if (params.explain_max_variants != null)       { parts << "--max-variants ${params.explain_max_variants}" }
    if (params.explain_top_k_variants != null)     { parts << "--top-k-variants ${params.explain_top_k_variants}" }
    if (params.explain_top_k_interactions != null) { parts << "--top-k-interactions ${params.explain_top_k_interactions}" }
    if (params.explain_attention_threshold != null)      { parts << "--attention-threshold ${params.explain_attention_threshold}" }
    if (params.explain_attention_threshold_mode != null) { parts << "--attention-threshold-mode ${params.explain_attention_threshold_mode}" }
    if (params.explain_attention_percentile != null)     { parts << "--attention-percentile ${params.explain_attention_percentile}" }
    if (params.explain_aggregation_method != null)       { parts << "--aggregation-method ${params.explain_aggregation_method}" }
    if (params.explain_batch_size != null)               { parts << "--batch-size ${params.explain_batch_size}" }
    if (params.explain_skip_ig)        { parts << '--skip-ig' }
    if (params.explain_skip_attention) { parts << '--skip-attention' }
    if (params.pc_map) {
        parts << "--pc-map ${file(params.pc_map).toAbsolutePath()}"
    }
    if (params.num_pcs != null && (params.num_pcs as Integer) > 0) {
        parts << "--num-pcs ${params.num_pcs}"
    }
    parts << "--genome-build ${params.genome_build}"
    return parts.join(' ')
}

def bootstrapExtraArgs = {
    def parts = []
    if (params.bootstrap_top_k) {
        parts << "--top-k ${params.bootstrap_top_k}"
    }
    if (params.bootstrap_gene_delta_rank_aggregation) {
        parts << "--gene-delta-rank-aggregation ${params.bootstrap_gene_delta_rank_aggregation}"
    }
    if (params.bootstrap_min_variants_per_gene != null) {
        parts << "--min-variants-per-gene ${params.bootstrap_min_variants_per_gene}"
    }
    if (params.bootstrap_exclude_sex_chroms) {
        parts << '--exclude-sex-chroms'
    }
    parts << "--genome-build ${params.genome_build}"
    return parts.join(' ')
}

def compareExtraArgs = {
    def parts = []
    parts << "--genome-build ${params.genome_build}"
    if (params.compare_exclude_sex_chroms) {
        parts << '--exclude-sex-chroms'
    }
    return parts.join(' ')
}

def chrxExtraArgs = {
    def parts = []
    parts << "--genome-build ${params.genome_build}"
    if (params.chrx_include_sex_chroms) {
        parts << '--include-sex-chroms'
    }
    return parts.join(' ')
}

process {
    // Result publishing is configured through entry-workflow outputs in `main.nf`.

    withName: 'SIEVE_TRAIN_.*' {
        ext.args = { trainExtraArgs() }
    }

    withName: 'SIEVE_EXPLAIN.*' {
        ext.args = { explainExtraArgs() }
    }

    withName: 'SIEVE_BOOTSTRAP_NULL_CALIBRATION.*' {
        ext.args = { bootstrapExtraArgs() }
    }

    withName: 'SIEVE_COMPARE_ATTRIBUTIONS.*' {
        ext.args = { compareExtraArgs() }
    }

    withName: 'SIEVE_CORRECT_CHRX_BIAS.*' {
        ext.args = { chrxExtraArgs() }
    }
}
