/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running small-fixture tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses the additional local fixtures under assets/testdata.

    Use as follows:
        nextflow run nf-core/sieve -c conf/test_small.config -stub-run --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Small fixture test profile'
    config_profile_description = 'Small local fixtures with parsed validation resources'

    // Input data
    vcf          = "${projectDir}/assets/testdata/small_test_data.vcf.gz"
    phenotypes   = "${projectDir}/assets/testdata/small_test_data_phenotypes.tsv"
    genome_build = 'GRCh38'
    infer_sex    = false
    sex_map      = "${projectDir}/assets/testdata/sex_map.tsv"

    // Optional discovery validation resources
    clinvar_tsv     = "${projectDir}/assets/testdata/parsed_clinvar.tsv"
    gwas_tsv        = "${projectDir}/assets/testdata/parsed_gwas.tsv"
    go_mapping_json = "${projectDir}/assets/testdata/parsed_go.json"
}
