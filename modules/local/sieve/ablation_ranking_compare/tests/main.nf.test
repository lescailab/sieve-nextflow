nextflow_process {

    name "Test Process SIEVE_ABLATION_RANKING_COMPARE"
    script "../main.nf"
    process "SIEVE_ABLATION_RANKING_COMPARE"
    config "./nextflow.config"

    tag "modules"
    tag "local"
    tag "ablation_ranking_compare"

    test("stub run") {

        options "-stub"

        when {
            process {
                """
input[0] = [ id: 'cohort' ]
input[1] = [
    file("${projectDir}/assets/testdata/parsed_clinvar.tsv", checkIfExists: true),
    file("${projectDir}/assets/testdata/parsed_gwas.tsv", checkIfExists: true)
]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ranking_comparison != null },
                { assert process.out.versions != null }
            )
        }
    }
}
