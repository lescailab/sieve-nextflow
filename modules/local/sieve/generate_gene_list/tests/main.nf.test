nextflow_process {

    name "Test Process SIEVE_GENERATE_GENE_LIST"
    script "../main.nf"
    process "SIEVE_GENERATE_GENE_LIST"
    config "./nextflow.config"

    tag "modules"
    tag "local"
    tag "generate_gene_list"

    test("stub run") {

        options "-stub"

        when {
            process {
                """
input[0] = [
    [ id: 'cohort', run_id: 'gene_list_L3', level: 'L3' ],
    file("${projectDir}/assets/testdata/parsed_clinvar.tsv", checkIfExists: true),
    file("${projectDir}/assets/testdata/parsed_gwas.tsv", checkIfExists: true),
    file("${projectDir}/assets/testdata/parsed_go.json", checkIfExists: true)
]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.gene_list_delta != null },
                { assert process.out.gene_list_zattr != null },
                { assert process.out.variant_rankings != null },
                { assert process.out.versions != null }
            )
        }
    }
}
