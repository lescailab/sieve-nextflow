nextflow_process {

    name "Test Process SIEVE_PLOT_ABLATION_COMPARISON"
    script "../main.nf"
    process "SIEVE_PLOT_ABLATION_COMPARISON"
    config "./nextflow.config"

    tag "modules"
    tag "local"
    tag "plot_ablation_comparison"

    test("stub run") {

        options "-stub"

        when {
            process {
                """
input[0] = [
    [ id: 'cohort' ],
    file("${projectDir}/assets/testdata/parsed_clinvar.tsv", checkIfExists: true),
    file("${projectDir}/assets/testdata/parsed_gwas.tsv", checkIfExists: true),
    file("${projectDir}/assets/testdata/test_model/L3_run/config.yaml", checkIfExists: true)
]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.plot != null },
                { assert process.out.versions != null }
            )
        }
    }
}
