{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/lescailab/sieve/master/nextflow_schema.json",
    "title": "lescailab/sieve pipeline parameters",
    "description": "Sparse Interpretable Exome Variant Explainer for case-control variant discovery.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/csv",
                    "description": "Legacy nf-core template samplesheet parameter (unused by this pipeline).",
                    "hidden": true
                },
                "vcf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.vcf\\.gz$",
                    "description": "Optional path to bgzipped multi-sample VCF (.vcf.gz). Required when preprocessing or sex inference must run.",
                    "help_text": "The file must be bgzipped and indexed (.tbi or .csi).",
                    "fa_icon": "fas fa-file"
                },
                "phenotypes": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional phenotype TSV with columns sample_id and phenotype. Required when preprocessing runs.",
                    "fa_icon": "fas fa-table"
                },
                "genome_build": {
                    "type": "string",
                    "description": "Reference genome build.",
                    "enum": ["GRCh37", "GRCh38"],
                    "default": "GRCh38",
                    "fa_icon": "fas fa-dna"
                },
                "infer_sex": {
                    "type": "boolean",
                    "description": "Infer sample sex from VCF when no sex map is provided.",
                    "default": true,
                    "fa_icon": "fas fa-venus-mars"
                },
                "known_sex": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional TSV of recorded sample sex metadata passed to sex inference for concordance checking only. It does not replace or pre-populate the inferred sample_sex.tsv output.",
                    "fa_icon": "fas fa-file-lines"
                },
                "sex_map": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional TSV mapping sample_id to sex. If provided, sex inference is skipped.",
                    "fa_icon": "fas fa-file-lines"
                },
                "preprocessed_data": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.pt$",
                    "description": "Optional preprocessed dataset (.pt). If provided, VCF preprocessing is skipped.",
                    "fa_icon": "fas fa-file-archive"
                },
                "best_params": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.ya?ml$",
                    "description": "Optional best-parameter YAML. If provided, hyperparameter grid search is skipped.",
                    "fa_icon": "fas fa-file-code",
                    "hidden": true
                },
                "best_checkpoint": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.pt$",
                    "description": "Optional model checkpoint (.pt). Must be provided together with --checkpoint_config to skip CV training.",
                    "fa_icon": "fas fa-file-archive",
                    "hidden": true
                },
                "checkpoint_config": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.ya?ml$",
                    "description": "Optional model config YAML paired with --best_checkpoint.",
                    "fa_icon": "fas fa-file-code",
                    "hidden": true
                },
                "execute_step": {
                    "type": "string",
                    "description": "Optional comma-separated list of pipeline steps to execute (for example: ablation,explain). Allowed: sex, preprocess, grid, cv, explain, ablation, null, epistasis, validation, plots.",
                    "fa_icon": "fas fa-list-check"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "The output directory where the results will be saved.",
                    "fa_icon": "fas fa-folder-open"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion summary.",
                    "fa_icon": "fas fa-envelope",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$"
                }
            }
        },
        "workflow_options": {
            "title": "SIEVE workflow options",
            "type": "object",
            "fa_icon": "fas fa-sliders",
            "description": "Advanced SIEVE options with safe defaults.",
            "properties": {
                "default_train_level": {
                    "type": "string",
                    "enum": ["L0", "L1", "L2", "L3"],
                    "default": "L3",
                    "description": "Default annotation level used for primary model training.",
                    "hidden": true
                },
                "cv_folds": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 2,
                    "description": "Number of folds used in cross-validation.",
                    "hidden": true
                },
                "val_split": {
                    "type": "number",
                    "default": 0.2,
                    "minimum": 0.01,
                    "maximum": 0.5,
                    "description": "Validation split used for non-CV training.",
                    "hidden": true
                },
                "null_seed": {
                    "type": "integer",
                    "default": 42,
                    "description": "Random seed for null baseline generation.",
                    "hidden": true
                },
                "null_bootstrap": {
                    "type": "integer",
                    "default": 1000,
                    "minimum": 100,
                    "description": "Number of bootstrap iterations for null calibration.",
                    "hidden": true
                },
                "cohort_id": {
                    "type": "string",
                    "default": "cohort",
                    "description": "Internal cohort identifier used in tuple metadata.",
                    "hidden": true
                },
                "train_epochs": {
                    "type": "integer",
                    "default": 100,
                    "minimum": 1,
                    "description": "Epochs per training run.",
                    "hidden": true
                },
                "train_batch_size": {
                    "type": "integer",
                    "default": 16,
                    "minimum": 1,
                    "description": "Batch size for all training stages; larger values increase GPU memory usage.",
                    "hidden": true
                },
                "train_chunk_size": {
                    "type": "integer",
                    "default": 3000,
                    "minimum": 100,
                    "description": "Chunk size for all training stages; larger values increase GPU memory usage.",
                    "hidden": true
                },
                "train_aggregation_method": {
                    "type": "string",
                    "default": "mean",
                    "description": "Aggregation method passed to SIEVE training.",
                    "hidden": true
                },
                "train_gradient_accumulation_steps": {
                    "type": "integer",
                    "default": 4,
                    "minimum": 1,
                    "description": "Gradient accumulation steps for all training stages.",
                    "hidden": true
                },
                "train_gradient_clip": {
                    "type": "number",
                    "default": 1.0,
                    "minimum": 0.0,
                    "description": "Gradient clipping threshold for all training stages.",
                    "hidden": true
                },
                "train_seed": {
                    "type": "integer",
                    "default": 42,
                    "description": "Training random seed.",
                    "hidden": true
                },
                "train_device": {
                    "type": "string",
                    "default": "cuda",
                    "description": "Training device passed to SIEVE (for example cuda or cpu).",
                    "hidden": true
                },
                "train_early_stopping": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "description": "Early stopping patience for training runs.",
                    "hidden": true
                },
                "train_hidden_dim": {
                    "type": "integer",
                    "default": 64,
                    "minimum": 1,
                    "description": "Default hidden dimension used across training stages.",
                    "hidden": true
                },
                "train_num_attention_layers": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 1,
                    "description": "Default number of attention layers used across training stages.",
                    "hidden": true
                },
                "grid_lr": {
                    "type": ["array", "string"],
                    "description": "Advanced: learning-rate values for internal grid search.",
                    "default": ["0.00001", "0.0001"],
                    "hidden": true
                },
                "grid_lambda_attr": {
                    "type": ["array", "string"],
                    "description": "Advanced: lambda_attr values for internal grid search.",
                    "default": [0.01, 0.1, 0.5, 1.0],
                    "hidden": true
                },
                "grid_latent_dim": {
                    "type": ["array", "string"],
                    "description": "Advanced: latent dimension values for internal grid search.",
                    "default": [32, 64],
                    "hidden": true
                },
                "grid_hidden_dim": {
                    "type": ["array", "string"],
                    "description": "Advanced: hidden dimension values for internal grid search.",
                    "default": [64, 128],
                    "hidden": true
                },
                "grid_num_attention_layers": {
                    "type": ["array", "string"],
                    "description": "Advanced: number of attention layers for internal grid search.",
                    "default": [1, 2],
                    "hidden": true
                },
                "clinvar_tsv": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Optional ClinVar TSV for discovery validation. Downloaded automatically if not provided.",
                    "hidden": true
                },
                "gwas_tsv": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Optional GWAS TSV for discovery validation. Downloaded automatically if not provided.",
                    "hidden": true
                },
                "go_mapping_json": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Optional GO mapping JSON for discovery validation. Downloaded automatically if not provided.",
                    "hidden": true
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional config options",
            "type": "object",
            "fa_icon": "fas fa-university",
            "description": "Parameters used to describe centralised config profiles. These should not be edited.",
            "help_text": "The centralised nf-core configuration profiles use a handful of pipeline parameters to describe themselves.",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "description": "Git commit id for institutional configs.",
                    "default": "master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "custom_config_base": {
                    "type": "string",
                    "description": "Base directory for institutional configs.",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "Institutional config name.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_description": {
                    "type": "string",
                    "description": "Institutional config description.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "Institutional config contact information.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "Institutional config URL link.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for completion summary, only when pipeline fails.",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$",
                    "hidden": true
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send plain-text email instead of HTML.",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "hidden": true
                },
                "hook_url": {
                    "type": "string",
                    "description": "Incoming hook URL for messaging service.",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "hidden": true
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "description": "Base URL or local path to location of pipeline test dataset files",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "description": "Suffix to add to trace/report/timeline filenames.",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full detailed help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/workflow_options"
        },
        {
            "$ref": "#/$defs/institutional_config_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
