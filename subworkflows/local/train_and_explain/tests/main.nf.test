nextflow_workflow {

    name "Test Workflow TEST_TRAIN_AND_EXPLAIN"
    script "./harness.nf"
    workflow "TEST_TRAIN_AND_EXPLAIN"
    config "./nextflow.config"

    tag "subworkflows"
    tag "local"
    tag "train_and_explain"

    test("stub run") {

        options "-stub-run"

        when {
            workflow {
                """
input[0] = channel.of([ id: 'cohort' ])
input[1] = channel.of(tuple('cohort', file("${projectDir}/assets/testdata/small_reprocessed_test.pt", checkIfExists: true)))
input[2] = channel.of(tuple('cohort', file("${projectDir}/assets/testdata/sex_map.tsv", checkIfExists: true)))
input[3] = channel.of(tuple('cohort', file("${projectDir}/assets/testdata/test_model/L3_run/config.yaml", checkIfExists: true)))
input[4] = channel.of(tuple('cohort', [
    lr: 0.0001,
    lambda_attr: 0.1,
    latent_dim: 32,
    hidden_dim: 64,
    num_attention_layers: 1,
    batch_size: 16,
    chunk_size: 3000,
    aggregation_method: 'mean',
    epochs: 100,
    gradient_accumulation_steps: 4,
    gradient_clip: 1.0,
    seed: 42,
    device: 'cuda',
    early_stopping: 10
]))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.versions != null }
            )
        }
    }
}
