nextflow_workflow {

    name "Test Workflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"
    config "./nextflow.config"

    tag "subworkflows"
    tag "local"
    tag "utils_nfcore_sieve_pipeline"

    test("stub run") {

        options "-stub-run"

        when {
            workflow {
                """
input[0] = false
input[1] = false
input[2] = false
input[3] = []
input[4] = "$outputDir"
input[5] = "${projectDir}/assets/testdata/small_test_data.vcf.gz"
input[6] = "${projectDir}/assets/testdata/small_test_data_phenotypes.tsv"
input[7] = 'GRCh38'
input[8] = false
input[9] = "${projectDir}/assets/testdata/sex_map.tsv"
input[10] = null
input[11] = null
input[12] = null
input[13] = null
input[14] = null
input[15] = false
input[16] = false
input[17] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.versions != null }
            )
        }
    }
}
