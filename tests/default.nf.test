nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("test profile - stub run") {

        config "../conf/test.config"
        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_sieve_software_versions.yml")).match() },
                { assert new File("$outputDir/sex_inference/sample_sex.tsv").exists() },
                { assert new File("$outputDir/preprocess/preprocessed.pt").exists() },
                { assert new File("$outputDir/grid_search/selection/best_params.yaml").exists() },
                { assert new File("$outputDir/cross_validation/selection/best_checkpoint.pt").exists() },
                { assert new File("$outputDir/explainability/real/sieve_variant_rankings.csv").exists() },
                { assert new File("$outputDir/ablation/summary/ablation_summary.tsv").exists() },
                { assert new File("$outputDir/null_baseline/comparison/comparison_summary.yaml").exists() },
                { assert new File("$outputDir/epistasis/epistasis_validation.csv").exists() },
                { assert new File("$outputDir/discovery_validation/validation_report.yaml").exists() }
            )
        }
    }

    test("test_full profile - stub run") {

        config "../conf/test_full.config"
        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !new File("$outputDir/sex_inference/sample_sex.tsv").exists() },
                { assert new File("$outputDir/preprocess/preprocessed.pt").exists() },
                { assert new File("$outputDir/grid_search/selection/best_params.yaml").exists() },
                { assert new File("$outputDir/cross_validation/selection/best_checkpoint.pt").exists() },
                { assert new File("$outputDir/explainability/real/sieve_variant_rankings.csv").exists() },
                { assert new File("$outputDir/null_baseline/comparison/comparison_summary.yaml").exists() },
                { assert new File("$outputDir/discovery_validation/validation_report.yaml").exists() }
            )
        }
    }

    test("small fixtures and validation resources - stub run") {

        config "../conf/test_small.config"
        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/preprocess/preprocessed.pt").exists() },
                { assert new File("$outputDir/grid_search/selection/train_grid_summary.tsv").exists() },
                { assert new File("$outputDir/cross_validation/selection/cv_folds_summary.tsv").exists() },
                { assert new File("$outputDir/explainability/real/sieve_gene_rankings.csv").exists() },
                { assert new File("$outputDir/null_baseline/comparison/comparison_summary.yaml").exists() },
                { assert new File("$outputDir/discovery_validation/validation_report.yaml").exists() }
            )
        }
    }
}
