nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test -stub-run") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert new File("$outputDir/preprocess/preprocessed.pt").exists() },
                { assert new File("$outputDir/grid_search/selection/best_params.yaml").exists() },
                { assert new File("$outputDir/cross_validation/selection/best_checkpoint.pt").exists() },
                { assert new File("$outputDir/explainability/real/sieve_variant_rankings.csv").exists() },
                { assert new File("$outputDir/ablation/summary/ablation_summary.tsv").exists() },
                { assert new File("$outputDir/null_baseline/comparison/comparison_summary.yaml").exists() },
                { assert new File("$outputDir/discovery_validation/validation_report.yaml").exists() }
            )
        }
    }
}
